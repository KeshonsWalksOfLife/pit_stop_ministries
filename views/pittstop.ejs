<body>
    <%- include('partials/nav') %>

    <main id="pittstop-main">
        <!-- HERO -->
        <section class="ps-hero">
            <div class="ps-hero-text">
                <p class="ps-eyebrow">The Pitt Stop</p>
                <!-- Confirmed Changes. -->
                <h1>Every soul needs a pit stop.</h1>
                <p class="ps-lead">A place to pull off the road, refuel on the Word, get repaired, and head back out stronger.</p>
                    <p><span class="ps-lead stretch">That's what Pitt Stop Ministries is built to be.</span></p>
            </div>
            <figure class="ps-hero-photo">
                <img src="/images/pop-picture.jpg" alt="Pastor Q of Pitt Stop Ministries" loading="lazy">
                <figcaption>Pastor Q</figcaption>
            </figure>
        </section>

        <!-- STORY -->
        <section class="ps-story">
            <h2 class="ps-section-title">Our Mission</h2>
            <!-- Confirmed Changes -->
            <p>TO ADVANCE THE KINGDOM OF GOD THROUGH</p>
            <p>TEACHING, PREACHING, AND DEMONSTRATION.</p>
            <p>OUR <span style="font-weight: bold; color:#ff6a26;">MISSION</span> IS TO FULFILL THE MANDATE OF GOD.</p>
            <p>REFERENCED IN GEN 1:26, 28.</p>
            <p>TO TAKE DOMINION AND CHANGE THIS WORLD SYSTEM,</p>
            <p>THROUGH JESUS CHRIST OUR KING.</p>
        </section>

        <!-- VALUES -->
        <section class="ps-values">
            <article class="ps-value">
                <h3>Refuel</h3>
                <p>Be filled by the Word and worship, every week.</p>
            </article>
            <article class="ps-value">
                <h3>Repair</h3>
                <p>Find healing, prayer, and a family that walks with you.</p>
            </article>
            <article class="ps-value">
                <h3>Send out</h3>
                <p>Get equipped and head back out to do what <strong>HE</strong> wants to do through you.</p>
            </article>

            <div class="ps-cta">
                    <a class="ps-btn ps-btn-primary" href="/sermons">Watch a message</a>
                    <a class="ps-btn ps-btn-ghost" href="/contacts">Plan a visit</a>
            </div>
        </section>
    </main>

