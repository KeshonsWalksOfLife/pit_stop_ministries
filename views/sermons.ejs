<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sermons</title>
    <meta name="description" content="Watch sermons from Pitt Stop Ministries. Pull in, refuel, and get back on the road.">
    <link rel="canonical" href="https://thepittstopministries.org/sermons">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Pitt Stop Ministries">
    <meta property="og:title" content="Sermons — Pitt Stop Ministries">
    <meta property="og:description" content="Watch sermons from Pitt Stop Ministries. Pull in, refuel, and get back on the road.">
    <meta property="og:url" content="https://thepittstopministries.org/sermons">
    <meta property="og:image" content="https://thepittstopministries.org/images/pop-picture.jpg">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Sermons — Pitt Stop Ministries">
    <meta name="twitter:description" content="Watch sermons from Pitt Stop Ministries. Pull in, refuel, and get back on the road.">
    <meta name="twitter:image" content="https://thepittstopministries.org/images/pop-picture.jpg">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Church",
      "name": "Pitt Stop Ministries",
      "url": "https://thepittstopministries.org",
      "logo": "https://thepittstopministries.org/images/pop-picture.jpg",
      "image": "https://thepittstopministries.org/images/pop-picture.jpg",
      "founder": {
        "@type": "Person",
        "name": "Pastor Q"
      },
      "sameAs": []
    }
    </script>
    <link rel="stylesheet" href="/css/sermons.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/type.css">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2H8RJXLDZR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2H8RJXLDZR');
    </script>
</head>
<body>
    <%- include('partials/nav') %>

    <section id="sermons-section">
        <header class="sermons-hero">
            <h1>Sermons</h1>
            <!-- Confirmed Changes -->
            <p class="sermons-tagline">Pull in, refuel, and get back on the road!</p>
        </header>

        <% if (featured) { %>
            <section class="featured">
                <h2 class="section-eyebrow">Latest message</h2>
                <article class="sermon-card featured-card">
                    <div class="sermon-video">
                        <button type="button" class="yt-facade" data-id="<%= featured.id %>" data-title="<%= featured.title %>" aria-label="Play: <%= featured.title %>">
                            <img class="yt-thumb" src="https://i.ytimg.com/vi/<%= featured.id %>/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
                            <span class="yt-play" aria-hidden="true"></span>
                        </button>
                    </div>
                    <h3 class="sermon-title"><%= featured.title %></h3>
                    <% if (featured.description) { %>
                        <p class="sermon-desc"><%= featured.description %></p>
                    <% } %>
                </article>
            </section>

            <% groups.forEach(function (group) { %>
                <section class="sermon-month">
                    <h2 class="month-heading"><%= group.label %></h2>
                    <div class="sermon-grid">
                        <% group.sermons.forEach(function (sermon) { %>
                            <article class="sermon-card">
                                <div class="sermon-video">
                                    <button type="button" class="yt-facade" data-id="<%= sermon.id %>" data-title="<%= sermon.title %>" aria-label="Play: <%= sermon.title %>">
                                        <img class="yt-thumb" src="https://i.ytimg.com/vi/<%= sermon.id %>/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
                                        <span class="yt-play" aria-hidden="true"></span>
                                    </button>
                                </div>
                                <h3 class="sermon-title"><%= sermon.title %></h3>
                                <% if (sermon.date) { %>
                                    <%# date shown in the title; tag kept for machine-readable semantics %>
                                    <time class="sermon-date" datetime="<%= sermon.date %>"></time>
                                <% } %>
                                <% if (sermon.description) { %>
                                    <p class="sermon-desc"><%= sermon.description %></p>
                                <% } %>
                            </article>
                        <% }); %>
                    </div>
                </section>
            <% }); %>
        <% } else { %>
            <p>Coming Soon...</p>
        <% } %>
    </section>

    <%- include('partials/footer') %>

    <script src="/js/nav.js" defer></script>
    <script src="/js/sermons.js" defer></script>
</body>
</html>